<Window x:Class="WindowsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan Align"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#EEF1F3"
        KeyDown="Window_KeyDown">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,7,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#202428" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="312" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="#FAFAF8"
            BorderBrush="#D1D7DA"
            BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
          <TextBlock Text="Scan Align"
                     FontSize="24"
                     FontWeight="SemiBold" />
          <TextBlock Text="Полуавтоматическое выравнивание сканов"
                     Margin="0,4,0,14"
                     Foreground="#5E666D"
                     TextWrapping="Wrap" />

          <Button x:Name="OpenButton"
                  Content="Открыть изображение"
                  Click="OpenButton_Click" />
          <Button x:Name="SaveButton"
                  Content="Сохранить результат"
                  IsEnabled="False"
                  Click="SaveButton_Click" />

          <Separator Margin="0,16,0,12" />

          <TextBlock Text="Контур"
                     FontSize="15"
                     FontWeight="SemiBold" />
          <Button x:Name="AnalyzeButton"
                  Content="Найти контур"
                  IsEnabled="False"
                  Click="AnalyzeButton_Click" />
          <Button x:Name="AlignButton"
                  Content="Выровнять по грани"
                  IsEnabled="False"
                  Click="AlignButton_Click" />

          <CheckBox x:Name="ShowContourCheckBox"
                    Content="Подсветка контура"
                    IsChecked="True"
                    Checked="OverlayOptionChanged"
                    Unchecked="OverlayOptionChanged" />
          <CheckBox x:Name="ShowGuidesCheckBox"
                    Content="Направляющие линии"
                    IsChecked="True"
                    Checked="OverlayOptionChanged"
                    Unchecked="OverlayOptionChanged" />
          <CheckBox x:Name="ShowDiagonalsCheckBox"
                    Content="Диагонали"
                    Checked="OverlayOptionChanged"
                    Unchecked="OverlayOptionChanged" />

          <TextBlock Text="Чувствительность"
                     Margin="0,14,0,0"
                     Foreground="#5E666D" />
          <Slider x:Name="SensitivitySlider"
                  Minimum="10"
                  Maximum="90"
                  Value="48"
                  TickFrequency="5"
                  IsSnapToTickEnabled="False"
                  ValueChanged="SensitivitySlider_ValueChanged" />

          <Separator Margin="0,16,0,12" />

          <TextBlock Text="Поворот"
                     FontSize="15"
                     FontWeight="SemiBold" />
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="-90"
                    Click="RotateLeftButton_Click" />
            <Button Grid.Column="2"
                    Content="+90"
                    Click="RotateRightButton_Click" />
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="RotationSlider"
                    Grid.Column="0"
                    Minimum="-180"
                    Maximum="180"
                    Value="0"
                    TickFrequency="1"
                    ValueChanged="RotationSlider_ValueChanged" />
            <TextBox x:Name="RotationTextBox"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     Text="0"
                     LostFocus="RotationTextBox_LostFocus"
                     KeyDown="RotationTextBox_KeyDown" />
          </Grid>

          <CheckBox x:Name="CenterSelectionCheckBox"
                    Content="Центровать найденное изображение"
                    Checked="OverlayOptionChanged"
                    Unchecked="OverlayOptionChanged" />

          <Separator Margin="0,16,0,12" />

          <TextBlock Text="Обрезка"
                     FontSize="15"
                     FontWeight="SemiBold" />
          <CheckBox x:Name="AutoCropCheckBox"
                    Content="Автообрезка по контуру"
                    IsChecked="True"
                    Checked="OverlayOptionChanged"
                    Unchecked="OverlayOptionChanged" />
          <CheckBox x:Name="ShowCropFrameCheckBox"
                    Content="Показывать рамку обрезки"
                    IsChecked="True"
                    Checked="OverlayOptionChanged"
                    Unchecked="OverlayOptionChanged" />

          <TextBlock Text="Отступ, px"
                     Margin="0,12,0,0"
                     Foreground="#5E666D" />
          <Grid Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="CropMarginSlider"
                    Grid.Column="0"
                    Minimum="0"
                    Maximum="300"
                    Value="20"
                    TickFrequency="1"
                    ValueChanged="CropMarginSlider_ValueChanged" />
            <TextBox x:Name="CropMarginTextBox"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     Text="20"
                     LostFocus="CropMarginTextBox_LostFocus"
                     KeyDown="CropMarginTextBox_KeyDown" />
          </Grid>

          <Separator Margin="0,16,0,12" />

          <TextBlock Text="Горячие клавиши"
                     FontSize="15"
                     FontWeight="SemiBold" />
          <TextBlock Text="Ctrl+O открыть, Ctrl+S сохранить, Ctrl+R контур"
                     Margin="0,6,0,0"
                     Foreground="#5E666D"
                     TextWrapping="Wrap" />

          <TextBlock x:Name="ImageInfoTextBlock"
                     Margin="0,16,0,0"
                     Foreground="#44505A"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="AnalysisInfoTextBlock"
                     Margin="0,8,0,0"
                     Foreground="#44505A"
                     TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Column="1"
          Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Background="#E4E9ED"
              BorderBrush="#C5CDD3"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12">
        <Grid>
          <Image x:Name="PreviewImage"
                 Stretch="Uniform"
                 SnapsToDevicePixels="True"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <Border x:Name="EmptyStatePanel"
                  Background="#F7F8F8"
                  BorderBrush="#CBD2D7"
                  BorderThickness="1"
                  CornerRadius="4"
                  Width="380"
                  Height="160"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center"
                        Margin="24">
              <TextBlock Text="Откройте скан для обработки"
                         FontSize="20"
                         FontWeight="SemiBold"
                         TextAlignment="Center" />
              <TextBlock Text="Также можно передать путь к файлу первым аргументом командной строки."
                         Margin="0,10,0,0"
                         Foreground="#66717A"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Margin="0,10,0,0"
              Padding="12,8"
              Background="#FAFAF8"
              BorderBrush="#D1D7DA"
              BorderThickness="1"
              CornerRadius="4">
        <TextBlock x:Name="StatusTextBlock"
                   Text="Готово"
                   Foreground="#39434B"
                   TextWrapping="Wrap" />
      </Border>
    </Grid>
  </Grid>
</Window>
